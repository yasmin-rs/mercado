# Chave da API do Gemini (Google AI Studio). Nunca versionar o .env.
GEMINI_API_KEY=
# Modelo da padronização de produtos (texto) e da leitura de fotos (visão)
MODEL_NAME=gemini/gemini-3.5-flash-lite
VISION_MODEL=gemini/gemini-3.5-flash-lite
# Alternativa local e gratuita (mais fraca nos nomes abreviados): MODEL_NAME=ollama/qwen2.5:7b
